# Used only by `npm run build` (the production Docker image). The API is reached
# same-origin through the nginx proxy defined in nginx.conf (/api/ → business-registry-api:8084),
# so the browser never has to talk to port 8084 directly and no CORS is involved.
# The dev server (docker-compose.dev.yml / vite dev) keeps using .env.
VITE_APP_URL=http://localhost:5000
VITE_APP_API_URL=http://localhost:5000
